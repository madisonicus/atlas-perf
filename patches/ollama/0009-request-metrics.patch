From 02439606857bf39170e251c25392569072bc73ee Mon Sep 17 00:00:00 2001
From: piargus <piargus@users.noreply.github.com>
Date: Fri, 27 Nov 2026 14:08:18 -0500
Subject: [PATCH 2/4] OLLAMA_REQUEST_METRICS: one numbers-only log line per
 chat request; draft acceptance by position

---
 mlxrunner/alt_stats.go    | 37 ++++++++++++++--
 mlxrunner/speculate.go    |  3 ++
 server/request_metrics.go | 90 +++++++++++++++++++++++++++++++++++++++
 server/routes.go          |  8 ++++
 4 files changed, 134 insertions(+), 4 deletions(-)
 create mode 100644 server/request_metrics.go

diff --git a/mlxrunner/alt_stats.go b/mlxrunner/alt_stats.go
index 90d45740..76137bca 100644
--- a/mlxrunner/alt_stats.go
+++ b/mlxrunner/alt_stats.go
@@ -12,10 +12,15 @@ import (
 var altStatsOn = os.Getenv("OLLAMA_MLX_ALT_STATS") == "1"
 
 type altCounter struct {
-	mu          sync.Mutex
-	rejects     [8]int
-	hits        [8]int
-	total, hitN int
+	// reached[i] and passed[i]: rounds whose draft reached position i+1, and
+	// those of them where the target accepted it. passed/reached = the
+	// acceptance rate at that position given every earlier one was accepted.
+	reached, passed [16]int
+	rounds          int
+	mu              sync.Mutex
+	rejects         [8]int
+	hits            [8]int
+	total, hitN     int
 }
 
 var altStats altCounter
@@ -40,3 +45,27 @@ func (a *altCounter) observe(pos int, hit bool) {
 		slog.Info("draft second choice at rejection", "hit_rate", fmt.Sprintf("%.2f", float64(a.hitN)/float64(a.total)), "by_position", s)
 	}
 }
+
+func (a *altCounter) round(drafted, accepted int) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	for i := 0; i < drafted && i < 16; i++ {
+		if i > accepted {
+			break
+		}
+		a.reached[i]++
+		if accepted > i {
+			a.passed[i]++
+		}
+	}
+	a.rounds++
+	if a.rounds%300 == 0 {
+		s := ""
+		for i := range 16 {
+			if a.reached[i] > 0 {
+				s += fmt.Sprintf("%d:%.2f(%d) ", i+1, float64(a.passed[i])/float64(a.reached[i]), a.reached[i])
+			}
+		}
+		slog.Info("draft acceptance by position", "rounds", a.rounds, "by_position", s)
+	}
+}
diff --git a/mlxrunner/speculate.go b/mlxrunner/speculate.go
index 33c65baf..8ba6e298 100644
--- a/mlxrunner/speculate.go
+++ b/mlxrunner/speculate.go
@@ -589,6 +589,9 @@ func (r *Runner) acceptDrafts(rounds []draftRound) []draftOutcome {
 			continue
 		}
 		out.observed = draftCount
+		if altStatsOn {
+			altStats.round(draftCount, out.accepted)
+		}
 		commitIDs := make([]int32, 0, out.accepted+1)
 		keep := out.accepted
 		done := false
diff --git a/server/request_metrics.go b/server/request_metrics.go
new file mode 100644
index 00000000..e2003f01
--- /dev/null
+++ b/server/request_metrics.go
@@ -0,0 +1,90 @@
+package server
+
+import (
+	"log/slog"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/ollama/ollama/llm"
+)
+
+// requestMetricsOn is OLLAMA_REQUEST_METRICS=1: one log line per chat request
+// with counts and times only, never text. It shows where a user's wait goes
+// (load, prompt reading, thinking, answer) and which client sent it.
+var requestMetricsOn = os.Getenv("OLLAMA_REQUEST_METRICS") == "1"
+
+type requestMetrics struct {
+	client, model string
+	private       bool
+	tools         bool
+	start         time.Time
+	firstToken    time.Time
+	firstAnswer   time.Time
+	thinkChunks   int
+	answerChunks  int
+	toolCalls     int
+	final         llm.CompletionResponse
+	done          bool
+}
+
+func newRequestMetrics(ua, model string, private bool, start time.Time, tools bool) *requestMetrics {
+	client := ua
+	if i := strings.IndexAny(client, " /"); i > 0 {
+		client = client[:i]
+	}
+	return &requestMetrics{client: client, model: model, private: private, start: start, tools: tools}
+}
+
+func (m *requestMetrics) observe(r llm.CompletionResponse, parsed bool) {
+	now := time.Now()
+	if r.Content != "" && m.firstToken.IsZero() {
+		m.firstToken = now
+	}
+	if !parsed && r.Content != "" {
+		m.answerChunks++
+		if m.firstAnswer.IsZero() {
+			m.firstAnswer = now
+		}
+	}
+	if r.Done {
+		m.final, m.done = r, true
+	}
+}
+
+func (m *requestMetrics) parsed(content, thinking string, toolCalls int) {
+	if thinking != "" {
+		m.thinkChunks++
+	}
+	if content != "" || toolCalls > 0 {
+		m.answerChunks++
+		m.toolCalls += toolCalls
+		if m.firstAnswer.IsZero() {
+			m.firstAnswer = time.Now()
+		}
+	}
+}
+
+func ms(t, from time.Time) int64 {
+	if t.IsZero() {
+		return -1
+	}
+	return t.Sub(from).Milliseconds()
+}
+
+func (m *requestMetrics) log() {
+	if !requestMetricsOn || !m.done {
+		return
+	}
+	f := m.final
+	cached := 0
+	if f.PromptEvalCachedCount != nil {
+		cached = *f.PromptEvalCachedCount
+	}
+	slog.Info("request metrics", "client", m.client, "model", m.model, "temporary", m.private, "tools", m.tools,
+		"prompt_tokens", f.PromptEvalCount, "cached_tokens", cached,
+		"prompt_ms", f.PromptEvalDuration.Milliseconds(), "eval_tokens", f.EvalCount, "eval_ms", f.EvalDuration.Milliseconds(),
+		"think_chunks", m.thinkChunks, "answer_chunks", m.answerChunks, "tool_calls", m.toolCalls,
+		"first_token_ms", ms(m.firstToken, m.start), "first_answer_ms", ms(m.firstAnswer, m.start),
+		"total_ms", time.Since(m.start).Milliseconds(), "done_reason", f.DoneReason.String())
+}
