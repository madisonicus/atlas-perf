 				Model:     req.Model,
 				CreatedAt: time.Now().UTC(),
@@ -3392,6 +3397,9 @@ func (s *Server) ChatHandler(c *gin.Context) {
 
 				res.Message.Content = content
 				res.Message.Thinking = thinking
+				if requestMetricsOn {
+					rm.parsed(content, thinking, len(toolCalls))
+				}
 				for i := range toolCalls {
 					toolCalls[i].ID = toolCallId()
 				}
