diff --git a/server/owner.go b/server/owner.go
new file mode 100644
index 00000000..c8ce8b49
--- /dev/null
+++ b/server/owner.go
@@ -0,0 +1,147 @@
+package server
+
+import (
+	"context"
+	"crypto/subtle"
+	"log/slog"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/ollama/ollama/api"
+)
+
+// OLLAMA_PRIORITY=1: while a chat request with an honored options.priority
+// (1 = chat, 2 = voice) runs, the server keeps a short lease on every loaded
+// MLX runner, and those runners pause requests of a lower tier
+// (mlxrunner/owner.go). A tier is honored only when options.priority_key
+// equals the key in OLLAMA_PRIORITY_KEY_FILE, so a tailnet caller cannot raise
+// its own tier.
+var priorityOn = os.Getenv("OLLAMA_PRIORITY") == "1"
+
+var priorityKey = func() string {
+	if f := os.Getenv("OLLAMA_PRIORITY_KEY_FILE"); f != "" {
+		if b, err := os.ReadFile(f); err == nil {
+			return strings.TrimSpace(string(b))
+		}
+		slog.Warn("priority key file unreadable; priority off", "file", f)
+	}
+	return ""
+}()
+
+const (
+	ownerLeaseSeconds = 3
+	maxPriorityTier   = 2
+)
+
+// honorPriority keeps opts.Priority only with the right key, then drops the
+// key so it never reaches a runner or a log.
+func honorPriority(opts *api.Options) int {
+	if opts == nil {
+		return 0
+	}
+	tier, key := opts.Priority, opts.PriorityKey
+	opts.Priority, opts.PriorityKey = 0, ""
+	if opts.PriorityKey == "" && key == "" && tier == 0 {
+		return 0
+	}
+	if !priorityOn || tier <= 0 || priorityKey == "" ||
+		subtle.ConstantTimeCompare([]byte(key), []byte(priorityKey)) != 1 {
+		return 0
+	}
+	tier = min(tier, maxPriorityTier)
+	opts.Priority = tier
+	return tier
+}
+
+type ownerLeaseSetter interface {
+	SetOwnerLease(ctx context.Context, seconds float64, tier int) error
+}
+
+var owner struct {
+	mu     sync.Mutex
+	counts [maxPriorityTier + 1]int
+	once   sync.Once
+	wake   chan struct{}
+	held   int
+}
+
+func ownerTop() int {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	for t := maxPriorityTier; t > 0; t-- {
+		if owner.counts[t] > 0 {
+			return t
+		}
+	}
+	return 0
+}
+
+func (s *Server) ownerBegin(tier int) {
+	owner.once.Do(func() {
+		owner.wake = make(chan struct{}, 1)
+		go s.ownerLoop()
+	})
+	owner.mu.Lock()
+	owner.counts[tier]++
+	owner.mu.Unlock()
+	s.ownerNudge()
+}
+
+func (s *Server) ownerEnd(tier int) {
+	owner.mu.Lock()
+	owner.counts[tier]--
+	owner.mu.Unlock()
+	s.ownerNudge()
+}
+
+func (s *Server) ownerNudge() {
+	select {
+	case owner.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (s *Server) ownerLoop() {
+	t := time.NewTicker(time.Second)
+	defer t.Stop()
+	for {
+		select {
+		case <-t.C:
+		case <-owner.wake:
+		}
+		top := ownerTop()
+		if top == 0 && owner.held == 0 {
+			continue
+		}
+		seconds := 0.0
+		if top > 0 {
+			seconds = ownerLeaseSeconds
+		}
+		s.ownerBroadcast(seconds, top)
+		owner.held = top
+	}
+}
+
+func (s *Server) ownerBroadcast(seconds float64, tier int) {
+	if s.sched == nil {
+		return
+	}
+	s.sched.loadedMu.Lock()
+	var targets []ownerLeaseSetter
+	for _, ref := range s.sched.loaded {
+		if ref == nil {
+			continue
+		}
+		if o, ok := ref.llama.(ownerLeaseSetter); ok {
+			targets = append(targets, o)
+		}
+	}
+	s.sched.loadedMu.Unlock()
+	for _, o := range targets {
+		ctx, cancel := context.WithTimeout(context.Background(), 500*time.Millisecond)
+		_ = o.SetOwnerLease(ctx, seconds, tier)
+		cancel()
+	}
+}
