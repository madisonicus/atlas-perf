 // Ping implements llm.LlamaServer.
+// SetOwnerLease tells the runner that a priority request runs on this server
+// for the next seconds (0 ends it). See OLLAMA_PRIORITY.
+func (c *Client) SetOwnerLease(ctx context.Context, seconds float64, tier int) error {
+	reqURL := fmt.Sprintf("http://127.0.0.1:%d/v1/owner", c.port)
+	req, err := http.NewRequestWithContext(ctx, "POST", reqURL, strings.NewReader(fmt.Sprintf(`{"seconds":%g,"tier":%d}`, seconds, tier)))
+	if err != nil {
+		return err
+	}
+	resp, err := c.client.Do(req)
+	if err != nil {
+		return err
+	}
+	resp.Body.Close()
+	return nil
+}
+
 func (c *Client) Ping(ctx context.Context) error {
 	reqURL := fmt.Sprintf("http://127.0.0.1:%d/v1/status", c.port)
 	req, err := http.NewRequestWithContext(ctx, "GET", reqURL, nil)
diff --git a/mlxrunner/owner.go b/mlxrunner/owner.go
new file mode 100644
index 00000000..055fc56e
--- /dev/null
+++ b/mlxrunner/owner.go
@@ -0,0 +1,72 @@
+package mlxrunner
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"sync/atomic"
+	"time"
+)
+
+// priorityOn is OLLAMA_PRIORITY=1. While a request with options.priority > 0
+// runs anywhere on this Ollama server, every MLX runner stops stepping the
+// prompt reading and generation of requests without it. Their state stays in
+// memory and they continue when the priority requests end. One background
+// stream cost the owner 22% of writing speed without it (M5 Ultra, 2026-11-27).
+var priorityOn = os.Getenv("OLLAMA_PRIORITY") == "1"
+
+// ownerLeaseUntil (unix ns) and ownerLeaseTier are set by the server through
+// POST /v1/owner while a priority request runs in any runner. A lease, so a
+// lost "end" message or a server crash cannot pause work for more than a few
+// seconds.
+var (
+	ownerLeaseUntil atomic.Int64
+	ownerLeaseTier  atomic.Int32
+)
+
+func ownerRemoteTier() int {
+	if time.Now().UnixNano() < ownerLeaseUntil.Load() {
+		return int(ownerLeaseTier.Load())
+	}
+	return 0
+}
+
+func ownerHandler(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Seconds float64 `json:"seconds"`
+		Tier    int     `json:"tier"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if body.Seconds <= 0 || body.Tier <= 0 {
+		ownerLeaseUntil.Store(0)
+	} else {
+		ownerLeaseTier.Store(int32(body.Tier))
+		ownerLeaseUntil.Store(time.Now().Add(time.Duration(body.Seconds * float64(time.Second))).UnixNano())
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (slot *batchSlot) tier() int {
+	if slot == nil || slot.request == nil {
+		return 0
+	}
+	return slot.request.request.Options.Priority
+}
+
+// topTier is the highest priority tier running now, here or in another
+// runner; requests below it wait this round. 0 = nobody waits.
+func (s *batchScheduler) topTier() int {
+	if !priorityOn {
+		return 0
+	}
+	top := ownerRemoteTier()
+	for _, slot := range s.slots {
+		if slot != nil && slot.request != nil && !slot.request.finished {
+			top = max(top, slot.tier())
+		}
+	}
+	return top
+}
