From cd0e5a9a7064efc9ee01d1503862806288ebbbea Mon Sep 17 00:00:00 2001
From: piargus <piargus@users.noreply.github.com>
Date: Fri, 27 Nov 2026 10:38:11 -0500
Subject: [PATCH] mlxrunner: env knobs for prefill chunk, snapshot budget,
 draft cap, max active memory

---
 mlxrunner/pipeline.go     | 13 ++++++++++++-
 mlxrunner/prefix_cache.go | 13 ++++++++++++-
 mlxrunner/retention.go    | 17 +++++++++++++++++
 mlxrunner/scheduler.go    | 13 +++++++++++++
 4 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/mlxrunner/pipeline.go b/mlxrunner/pipeline.go
index 9fc421a..b6a7233 100644
--- a/mlxrunner/pipeline.go
+++ b/mlxrunner/pipeline.go
@@ -6,8 +6,10 @@ import (
 	"errors"
 	"fmt"
 	"log/slog"
+	"os"
 	"slices"
 	"sort"
+	"strconv"
 	"time"
 
 	"github.com/ollama/ollama/llm"
@@ -20,8 +22,17 @@ import (
 	"github.com/ollama/ollama/mlxrunner/tokenizer"
 )
 
-func prefillChunkSize() int {
+// prefillChunk is OLLAMA_MLX_PREFILL_CHUNK (tokens, a power of two up to 8192),
+// default 2048. Larger chunks give the matrix units bigger tiles.
+var prefillChunk = func() int {
+	if n, err := strconv.Atoi(os.Getenv("OLLAMA_MLX_PREFILL_CHUNK")); err == nil && n >= 256 && n <= 8192 && n&(n-1) == 0 {
+		return n
+	}
 	return 2 << 10
+}()
+
+func prefillChunkSize() int {
+	return prefillChunk
 }
 
 // prefillPlan holds the absolute batch ends for models that are sensitive to
diff --git a/mlxrunner/prefix_cache.go b/mlxrunner/prefix_cache.go
index e7601d2..bb71fa5 100644
--- a/mlxrunner/prefix_cache.go
+++ b/mlxrunner/prefix_cache.go
@@ -32,7 +32,9 @@ import (
 	"cmp"
 	"fmt"
 	"log/slog"
+	"os"
 	"slices"
+	"strconv"
 	"time"
 
 	"github.com/ollama/ollama/logutil"
@@ -42,7 +44,16 @@ import (
 
 const prefillSnapshotInterval = 8192
 
-const maxPagedOutBytes int64 = 8 << 30 // 8 GiB eviction threshold for paged-out snapshot memory
+// maxPagedOutBytes is the eviction threshold for paged-out snapshot memory,
+// shared by all parallel slots. OLLAMA_MLX_SNAPSHOT_GB overrides the 8 GiB
+// default: with 4 slots each slot keeps 2 GiB, less than the KV of a long
+// chat, so a 139k-token chat re-read 8k tokens per turn (M5 Ultra, 2026-11-27).
+var maxPagedOutBytes = func() int64 {
+	if gb, err := strconv.Atoi(os.Getenv("OLLAMA_MLX_SNAPSHOT_GB")); err == nil && gb > 0 {
+		return int64(gb) << 30
+	}
+	return 8 << 30
+}()
 
 type prefixCache struct {
 	root          *trieNode   // root of the prefix trie
diff --git a/mlxrunner/retention.go b/mlxrunner/retention.go
index ada5768..3b074df 100644
--- a/mlxrunner/retention.go
+++ b/mlxrunner/retention.go
@@ -4,6 +4,8 @@ import (
 	"context"
 	"log/slog"
 	"math"
+	"os"
+	"strconv"
 	"time"
 
 	"github.com/ollama/ollama/discover"
@@ -202,5 +204,20 @@ func physicalHistoryLimit(memory discover.MemoryHeadroom, before, active, reusab
 			target = min(target, max(1, active+immediate))
 		}
 	}
+	if maxActiveBytes > 0 {
+		target = min(target, maxActiveBytes)
+	}
 	return target
 }
+
+// maxActiveBytes is OLLAMA_MLX_MAX_ACTIVE_GB: a hard cap on this runner's MLX
+// memory, weights and saved prompt history together. Without it the history
+// grows into all memory the host reports as available, even when other runners
+// need it: a game-like load took Qwen3.6 35B-A3B from 23 to 79 GB in 10 minutes,
+// and 12.8 GB went to swap (M5 Ultra, 96 GB, 2026-11-27).
+var maxActiveBytes = func() int64 {
+	if gb, err := strconv.Atoi(os.Getenv("OLLAMA_MLX_MAX_ACTIVE_GB")); err == nil && gb > 0 {
+		return int64(gb) << 30
+	}
+	return 0
+}()
diff --git a/mlxrunner/scheduler.go b/mlxrunner/scheduler.go
index a5d6861..22381b1 100644
--- a/mlxrunner/scheduler.go
+++ b/mlxrunner/scheduler.go
@@ -3,7 +3,9 @@ package mlxrunner
 import (
 	"context"
 	"log/slog"
+	"os"
 	"slices"
+	"strconv"
 	"time"
 
 	"github.com/ollama/ollama/discover"
@@ -612,6 +614,11 @@ func (s *batchScheduler) emit(slot *batchSlot, results []sample.Result, err erro
 // for a shared target forward when multiple requests are active.
 // Proposals, sampling and rollback still belong to each request. Plain rows keep
 // their pipelined forward; no request waits for a peer to choose the same depth.
+var maxDraftActive = func() int {
+	n, _ := strconv.Atoi(os.Getenv("OLLAMA_MLX_DRAFT_MAX_ACTIVE"))
+	return n
+}()
+
 func (s *batchScheduler) decode(ready []*batchSlot, active int) error {
 	// A prefilling or backpressured peer still affects decode costs. Only a
 	// request running alone may use and train its isolated depth controller.
@@ -626,6 +633,12 @@ func (s *batchScheduler) decode(ready []*batchSlot, active int) error {
 	if s.r.spec == nil {
 		return s.decodePlain(ready)
 	}
+	// OLLAMA_MLX_DRAFT_MAX_ACTIVE=k decodes plainly when more than k requests
+	// are active. With 4 parallel requests on an M5 Ultra, drafting cost
+	// more than it saved: 171 tok/s total against 195 plain (2026-11-27).
+	if maxDraftActive > 0 && active > maxDraftActive {
+		return s.decodePlain(ready)
+	}
 	type group struct {
 		slots  []*batchSlot
 		rounds []draftRound
-- 
