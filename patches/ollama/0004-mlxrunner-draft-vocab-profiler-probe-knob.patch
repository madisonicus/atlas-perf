diff --git a/mlxrunner/model/qwen3_5/draft_vocab.go b/mlxrunner/model/qwen3_5/draft_vocab.go
new file mode 100644
index 0000000..398f897
--- /dev/null
+++ b/mlxrunner/model/qwen3_5/draft_vocab.go
@@ -0,0 +1,107 @@
+package qwen3_5
+
+import (
+	"encoding/binary"
+	"math"
+	"os"
+	"strconv"
+	"sync"
+
+	"github.com/ollama/ollama/mlx"
+	"github.com/ollama/ollama/mlxrunner/nn"
+)
+
+// draftVocab is OLLAMA_MLX_DRAFT_VOCAB=N: the MTP head proposes only from
+// token ids [0, N). Its unembed reads N rows of lm_head instead of the full
+// vocabulary. Verification still uses the full head, so output does not
+// change; only draft acceptance can drop. Low ids are the early BPE merges,
+// the most frequent tokens.
+var draftVocab = func() int {
+	n, _ := strconv.Atoi(os.Getenv("OLLAMA_MLX_DRAFT_VOCAB"))
+	return n
+}()
+
+// draftVocabFile is OLLAMA_MLX_DRAFT_VOCAB_FILE: little-endian int32 token
+// ids, most frequent first. With it the draft head keeps the first N ids of
+// the file instead of ids [0, N).
+var draftVocabFile = os.Getenv("OLLAMA_MLX_DRAFT_VOCAB_FILE")
+
+func readRank(path string, n int) []int32 {
+	b, err := os.ReadFile(path)
+	if err != nil || len(b) < 4*n {
+		return nil
+	}
+	ids := make([]int32, n)
+	for i := range ids {
+		ids[i] = int32(binary.LittleEndian.Uint32(b[4*i:]))
+	}
+	return ids
+}
+
+type draftHead struct {
+	ids   *mlx.Array
+	once  sync.Once
+	head  *nn.QuantizedLinear
+	ninf  *mlx.Array
+	vocab int
+	held  *mlx.Scope
+}
+
+var draftHeads sync.Map // *Model -> *draftHead
+
+func (m *Model) draftUnembed(x *mlx.Array) *mlx.Array {
+	ql, ok := m.LMHead.(*nn.QuantizedLinear)
+	if draftVocab <= 0 || !ok || ql.Bias != nil || ql.GlobalScale != nil || draftVocab >= ql.Weight.Dim(0) {
+		return m.Unembed(x)
+	}
+	v, _ := draftHeads.LoadOrStore(m, &draftHead{})
+	dh := v.(*draftHead)
+	dh.once.Do(func() {
+		dh.held = mlx.NewScope()
+		n := draftVocab
+		dh.vocab = ql.Weight.Dim(0)
+		sl := func(a *mlx.Array) *mlx.Array {
+			if a == nil {
+				return nil
+			}
+			return a.Slice(mlx.Slice(0, n), mlx.Slice())
+		}
+		if draftVocabFile != "" {
+			if rank := readRank(draftVocabFile, n); rank != nil {
+				dh.ids = mlx.FromValues(rank, n)
+				sl = func(a *mlx.Array) *mlx.Array {
+					if a == nil {
+						return nil
+					}
+					return mlx.Take(a, dh.ids, 0)
+				}
+			}
+		}
+		dh.head = &nn.QuantizedLinear{Weight: sl(ql.Weight), Scales: sl(ql.Scales), QBiases: sl(ql.QBiases), GroupSize: ql.GroupSize, Bits: ql.Bits, Mode: ql.Mode}
+		dh.ninf = mlx.FromValue(float32(math.Inf(-1)))
+		keep := []*mlx.Array{dh.head.Weight, dh.head.Scales, dh.ninf}
+		if dh.ids != nil {
+			keep = append(keep, dh.ids)
+		}
+		if dh.head.QBiases != nil {
+			keep = append(keep, dh.head.QBiases)
+		}
+		mlx.Eval(keep...)
+		dh.held.Attach(keep...)
+	})
+	logits := dh.head.Forward(x)
+	if dh.ids != nil {
+		lead := logits.Dims()
+		rows := logits.Size() / draftVocab
+		flat := logits.Reshape(rows, draftVocab)
+		idx := mlx.BroadcastTo(dh.ids.AsType(mlx.DTypeInt32), int32(rows), int32(draftVocab))
+		base := mlx.AddScalar(mlx.Zeros(logits.DType(), rows, dh.vocab), float32(math.Inf(-1)))
+		lead[len(lead)-1] = dh.vocab
+		return base.PutAlongAxis(idx, flat, -1).Reshape(lead...)
+	}
+	last := logits.NumDims() - 1
+	return mlx.Pad(logits, []int{last}, []int{0}, []int{dh.vocab - draftVocab}, dh.ninf.AsType(logits.DType()), "constant")
+}
+
+// DraftLogits is the draft head for an external drafter such as DFlash2.
+func (m *Model) DraftLogits(x *mlx.Array) *mlx.Array { return m.draftUnembed(x) }
diff --git a/mlxrunner/model/qwen3_5/profile.go b/mlxrunner/model/qwen3_5/profile.go
new file mode 100644
index 0000000..8a4e9ce
--- /dev/null
+++ b/mlxrunner/model/qwen3_5/profile.go
@@ -0,0 +1,73 @@
+package qwen3_5
+
+import (
+	"fmt"
+	"log/slog"
+	"os"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/ollama/ollama/mlx"
+)
+
+// OLLAMA_MLX_PROFILE=1 syncs the GPU after each block and sums wall time by
+// block kind and forward width. Research only: the syncs slow decode.
+var profileOn = os.Getenv("OLLAMA_MLX_PROFILE") == "1"
+
+type profKey struct {
+	kind string
+	L    int32
+}
+
+var (
+	profMu    sync.Mutex
+	profSum   = map[profKey]time.Duration{}
+	profCount = map[profKey]int{}
+	profCalls int
+)
+
+func profMark(kind string, L int32, start time.Time, outs ...*mlx.Array) time.Time {
+	if !profileOn {
+		return start
+	}
+	mlx.Eval(outs...)
+	now := time.Now()
+	profMu.Lock()
+	k := profKey{kind, L}
+	profSum[k] += now.Sub(start)
+	profCount[k]++
+	profMu.Unlock()
+	return now
+}
+
+func profForwardDone() {
+	if !profileOn {
+		return
+	}
+	profMu.Lock()
+	defer profMu.Unlock()
+	profCalls++
+	if profCalls%200 != 0 {
+		return
+	}
+	keys := make([]profKey, 0, len(profSum))
+	for k := range profSum {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool {
+		if keys[i].L != keys[j].L {
+			return keys[i].L < keys[j].L
+		}
+		return keys[i].kind < keys[j].kind
+	})
+	for _, k := range keys {
+		fwd := profCount[profKey{"forward", k.L}]
+		if fwd == 0 {
+			fwd = 1
+		}
+		slog.Info("mlx profile", "L", k.L, "kind", k.kind, "ms_per_forward", fmt.Sprintf("%.3f", float64(profSum[k].Microseconds())/1000/float64(fwd)), "calls", profCount[k])
+	}
+	profSum = map[profKey]time.Duration{}
+	profCount = map[profKey]int{}
+}
