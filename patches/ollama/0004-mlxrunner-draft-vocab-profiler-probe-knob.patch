 }
 
 func (m *Model) Forward(b *batch.Batch, caches []cache.Layer) (hidden, auxHidden *mlx.Array) {
@@ -1320,6 +1326,11 @@ func (m *Model) Forward(b *batch.Batch, caches []cache.Layer) (hidden, auxHidden
 		mropeCos, mropeSin = mropeCosSin(m.Config, mp, L)
