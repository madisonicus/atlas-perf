 	if len(features) > 0 {
 		return out, mlx.Concatenate(features, -1)
 	}
@@ -1339,6 +1354,13 @@ func (m *Model) Forward(b *batch.Batch, caches []cache.Layer) (hidden, auxHidden
 }
 
 func (m *Model) Unembed(x *mlx.Array) *mlx.Array {
+	if profileOn {
+		t := time.Now()
+		mlx.Eval(x)
+		out := m.LMHead.Forward(x)
+		profMark("unembed", int32(x.Dims()[len(x.Dims())-2]), t, out)
+		return out
+	}
 	return m.LMHead.Forward(x)
 }
 
@@ -1357,7 +1379,7 @@ func (m *mtpDraft) NewCaches() []cache.Cache {
 // LoadWeights does nothing: an inline head's weights load with the target's.
 func (m *mtpDraft) LoadWeights(map[string]*mlx.Array) error { return nil }
 
-func (m *mtpDraft) Unembed(x *mlx.Array) *mlx.Array { return (*Model)(m).Unembed(x) }
+func (m *mtpDraft) Unembed(x *mlx.Array) *mlx.Array { return (*Model)(m).draftUnembed(x) }
 
