 	var features []*mlx.Array
 	for i, layer := range m.Layers {
 		var c cache.Layer
@@ -1332,6 +1343,10 @@ func (m *Model) Forward(b *batch.Batch, caches []cache.Layer) (hidden, auxHidden
 		}
 	}
 	out := m.Norm.Forward(h, m.RMSNormEps)
